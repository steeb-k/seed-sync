# Rust build output
/target
**/*.rs.bk

# Local runtime data / test scratch
*.db
*.db-shm
*.db-wal
/.seed-data/
**/iroh-data/
/scratch/

# macOS packaging: conda-forge GTK envs (created by scripts/setup-conda-macos.sh)
/.conda-gtk/

# Windows packaging artifacts
/dist/
/gtk-runtime/
*.msi
*.wixobj
*.wixpdb
