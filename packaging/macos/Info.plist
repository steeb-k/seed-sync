<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist for SEED Sync.app. __VERSION__ is rewritten from the Cargo version
     by scripts/package-macos.sh. The real GTK binary lives at Contents/MacOS/
     seed-gui (CFBundleExecutable), so NSBundle resolves to this bundle and the
     Dock/Applications icon comes from Resources/AppIcon.icns. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>SEED Sync</string>
  <key>CFBundleDisplayName</key>
  <string>SEED Sync</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.steeb_k.SeedSync</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleExecutable</key>
  <string>seed-gui</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>(c) kznjk LLC</string>
</dict>
</plist>
