<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- S.E.E.D. tray GUI autostart LaunchAgent. Analog of the Linux .desktop
     autostart entry: launch the GUI hidden (tray only) at login. No KeepAlive —
     if the user quits the GUI it stays quit until next login. Aqua-only (needs a
     GUI session). __APP__ is rewritten on install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.steeb_k.SeedSync.gui</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/Contents/MacOS/seed-gui</string>
    <string>--hidden</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
