# Maintainer: steeb-k <skaznak at protonmail dot com>
#
# Source of truth for the AUR package `seed-sync`. CI builds it on every
# release (with pkgver forced to the workspace version and the source replaced
# by the tagged tree); scripts/aur-prepare.sh copies it into an AUR clone, sets
# pkgver, fills in the real checksum and writes .SRCINFO. Keep it in step with
# the file set in packaging/linux/nfpm.yaml.
pkgname=seed-sync
pkgver=0.7.4
pkgrel=1
pkgdesc='Peer-to-peer mirrored folder sync, over iroh (S.E.E.D.)'
arch=('x86_64')
url='https://github.com/steeb-k/seed-sync-gtk'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'dbus')
makedepends=('cargo' 'git' 'imagemagick')
install=seed-sync.install
# makepkg's LTO compiles C dependencies (ring) to GCC LTO bitcode, which
# rustc's lld linker cannot read: the link fails on every ring_core_* symbol.
options=('!lto')
# The source repo is `seed-sync-gtk`; GitHub's tag archive extracts to
# seed-sync-gtk-$pkgver, not $pkgname-$pkgver.
_srcname=seed-sync-gtk
source=("$_srcname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# scripts/aur-prepare.sh replaces this with the tag archive's sum in the AUR copy.
sha256sums=('SKIP')

_appid=io.github.steeb_k.SeedSync
_iconsizes=(16 22 24 32 48 64 128 256 512)

prepare() {
  cd "$_srcname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked -p seed-daemon -p seed-gui -p seed-cli
}

package() {
  cd "$_srcname-$pkgver"

  local bin
  for bin in seed-daemon seed-gui seed-cli; do
    install -Dm0755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  # Kept for --status; it refuses to install/update/uninstall over this package
  # (packaging/linux/seed-sync's refuse_if_pkg_managed).
  install -Dm0755 packaging/linux/seed-sync "$pkgdir/usr/bin/seed-sync"

  # The per-user systemd unit. Same content as the tarball's, except
  # ExecStart, which points at /usr/bin instead of %h/.local/bin.
  install -Dm0644 packaging/linux/pkg/seed-daemon.service \
    "$pkgdir/usr/lib/systemd/user/seed-daemon.service"

  install -Dm0644 "packaging/linux/pkg/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm0644 "packaging/linux/$_appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"

  local IM
  if command -v magick >/dev/null 2>&1; then IM=magick; else IM=convert; fi
  local size
  for size in "${_iconsizes[@]}"; do
    install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    "$IM" icon/appIcon.png -resize "${size}x${size}" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_appid.png"
  done

  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
